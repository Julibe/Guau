---
import fs from "node:fs";

const baseImages = fs
	.readdirSync("public/images/dogs")
	.sort(() => Math.random() - 0.5);
const images = [...baseImages, ...baseImages, ...baseImages];
const rows = 5;
const line = 6;
let length = Math.floor(images.length / line) * line;
if (length > line * rows) {
	length = line * rows;
}
---

<section class="intro">
	<div class="grid">
		{
			Array.from({
				length: Math.ceil(length / line),
			}).map((_, lineIndex) => (
				<ul class="line" id={`line-${lineIndex}`}>
					{images
						.slice(lineIndex * line, lineIndex * line + line)
						.map((image, i) => {
							let image_name = image
								.replace(".webp", "")
								.replace(/_/g, " ")
								.split(" ")
								.map(
									(word) =>
										word.charAt(0).toUpperCase() +
										word.slice(1),
								)
								.join(" ");

							return (
								<li
									class="item"
									title={image_name}
									id={`item-${lineIndex * line + i}`}>
									<img
										src={`/images/dogs/${image}`}
										alt={image_name}
									/>
								</li>
							);
						})}
				</ul>
			))
		}
	</div>
</section>
