<style is:global>
	@tailwind base;
	@tailwind components;
	@tailwind utilities;

	@font-face {
		font-family: "Pulsar";
		src: url("/./fonts/pulsar.eot");
		src:
			url("/./fonts/pulsar.eot?#iefix") format("embedded-opentype"),
			url("/./fonts/pulsar.woff2") format("woff2"),
			url("/./fonts/pulsar.woff") format("woff"),
			url("/./fonts/pulsar.ttf") format("truetype"),
			url("/./fonts/pulsar.svg#pulsar") format("svg");
		font-weight: normal;
		font-style: normal;
		font-display: swap;
	}

	@font-face {
		font-family: "Acumin";
		src: url("/./fonts/acumin.eot");
		src:
			url("/./fonts/acumin.eot?#iefix") format("embedded-opentype"),
			url("/./fonts/acumin.woff2") format("woff2"),
			url("/./fonts/acumin.woff") format("woff"),
			url("/./fonts/acumin.ttf") format("truetype"),
			url("/./fonts/acumin.svg#acumin") format("svg");
		font-weight: normal;
		font-style: normal;
		font-display: swap;
	}

	html,
	body {
		--text: 255, 255, 255;
		--color: 0, 0, 0;
		@apply p-0 m-0 w-full;
		font-family: "Acumin";
		color: rgb(var(--text));
		background-color: rgb(var(--color));
	}

	figure,
	picture {
		@apply p-0 m-0 mb-0 mt-0;
	}

	*::selection {
		color: rgb(var(--text));
		background-color: rgb(var(--text));
	}

	h1,
	h2,
	h3,
	h4,
	h5,
	h6,
	p,
	hr,
	ol,
	ul,
	blockquote,
	table,
	pre,
	img,
	dl {
		@apply pb-4;
		font-family: "Acumin";
		font-weight: 100;
	}

	h1,
	h2,
	h3,
	h4,
	h5,
	h6 {
		@apply font-bold uppercase;
		font-family: "Pulsar";
		font-weight: 100;
	}

	h1 {
		@apply text-9xl;
	}

	h2 {
		@apply text-8xl;
	}

	h3 {
		@apply text-7xl;
	}

	h4 {
		@apply text-6xl;
	}

	h5 {
		@apply text-5xl;
	}

	h6 {
		@apply text-4xl;
	}

	p {
		@apply font-light text-xl leading-relaxed;
	}

	hr {
		@apply my-8 border-t-2 border-t-white;
	}

	a {
		@apply underline;
	}

	ul,
	ol {
		@apply ml-6;
	}

	li {
		@apply mb-2;
	}

	blockquote {
		@apply pl-4 border-l-4 italic my-4;
	}

	code {
		@apply rounded px-2 py-1 font-mono text-sm;
	}

	pre {
		@apply p-4 rounded-lg overflow-x-auto my-4;
	}

	figcaption {
		@apply text-sm italic mt-2;
	}

	table {
		@apply w-full border-collapse my-4;
	}

	th,
	td {
		@apply border p-2;
	}

	img,
	video {
		@apply max-w-full h-auto;
	}

	iframe {
		@apply w-full;
	}

	dl {
		@apply my-4;
	}

	dt {
		@apply font-bold;
	}

	dd {
		@apply ml-4;
	}

	@media;
</style>
