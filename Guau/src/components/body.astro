---
import { marked } from "marked";
import data from "../local_data.json";

import Layout from "./Layout.astro";
import Image from "./Image.astro";
import Product from "./Product.astro";

import Intro from "./Intro.astro";

import "../styles/styles.astro";

interface Props {
	lang?: string;
}
const { lang = "en" } = Astro.props;
interface Pages {
	guau: any;
	[key: string]: any;
}
const pages: Pages = data.pages?.[lang] || {};
const categories = data.lines?.[lang] || {};
const products = data.products?.[lang] || {};
const texts = data.texts?.[lang] || {};

const pageName: keyof Pages = (Astro.params?.page as string) || "home";
const page = pages[pageName] || pages.guau;
const projectName = "Guau";

const htmlContent = marked(page.content);
---

<Layout
	title={`${page.title} ${page.emoji} ${page.excerpt}`}
	description={page.description}
	lang={lang}>
	<Intro
		title={pages.home.title}
		excerpt={pages.home.excerpt}
		emoji={pages.home.emoji}
		more={texts.view.text}
		color={pages.home.color}
		text={pages.home.text}
	/>
	<article class="hidden">
		<h1>{page.title}</h1>
		{
			Object.entries(categories).map(
				([key, { id, title, emoji, excerpt, type, content }]) => (
					<section
						id={id}
						aria-labelledby={`category-${id}`}
						title={`${title} ${emoji} ${type}`}>
						<h2 id={`category-${id}`}>
							{title} {emoji}
						</h2>
						<p>{excerpt}</p>
						<h3>{type}</h3>
						<p set:html={content} />
						<Image
							src={`/images/categories/${id}.webp`}
							alt={`${title}`}
						/>
						<ul>
							{Object.entries(products)
								.filter(
									([key, product]) =>
										product.category === title,
								)
								.map(([key, product]) => (
									<Product parent={key} product={product} />
								))}
						</ul>
					</section>
				),
			)
		}

		<div set:html={htmlContent} />
	</article>
</Layout>
