---
import Image from "./Image.astro";
interface Props {
	product: {
		id: string;
		color: string;
		text: string;
		title: string;
		emoji: string;
		flavor: string;
		content: string;
	};
	parent: string;
}

const { product, parent } = Astro.props;
const { id, color, text, title, emoji, flavor, content } = product;

const cont = "<i>(" + flavor + ")</i><br>" + content;
---

<div
	id={`${parent}-${id}`}
	style={{
		backgroundColor: `rgb(${color})`,
		color: `rgb(${text})`,
	}}
	class="p-4"
	aria-labelledby={`title-${id}`}
	aria-describedby={`content-${id}`}>
	<h3 id={`title-${id}`} class="mb-1">
		{title}
		{emoji}
	</h3>
	<p id={`content-${id}`} set:html={cont} class="my-2 text-base" />
	<Image
		src={`/images/products/${id}.webp`}
		alt={`${title} ${emoji}`}
		class="mt-2"
	/>
</div>
